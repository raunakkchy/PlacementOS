# GEMINI_API_KEY: Primary key for Gemini AI calls.
# You can provide 1 key, or multiple keys separated by commas for load-balancing (e.g. key1,key2,key3,key4,key5)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Or provide multiple keys in a single list:
GEMINI_API_KEYS=""

# Or specify individual keys for rotation and 5x quota load balancing:
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string.
# If omitted or unavailable, PlacementOS automatically uses persistent storage.
MONGODB_URI=""

# ====================================================
# Email OTP Verification (Choose Option A or Option B)
# ====================================================

# OPTION A: HTTP Email API (RECOMMENDED FOR RENDER FREE TIER)
# Render's free tier blocks outbound SMTP ports 25, 465, and 587 to prevent spam.
# HTTP APIs use HTTPS (Port 443) which is NEVER blocked by Render or any cloud host.
# 1. Sign up free at https://resend.com (takes 30 seconds, 3,000 free emails/month)
# 2. Generate an API Key (starts with "re_...")
# 3. Add to Render Environment Variables:
RESEND_API_KEY=""
RESEND_FROM="Placement OS <onboarding@resend.dev>"

# OR use Brevo (formerly Sendinblue - https://brevo.com):
# BREVO_API_KEY=""

# OPTION B: SMTP (Gmail App Password)
# Works in Google AI Studio, Localhost, VPS, or Render Paid plans.
# On Render Free Tier, outbound ports 465/587 may be blocked by Render's firewall.
# SMTP_USER: Your full Gmail address (e.g., studentplacement@gmail.com)
# SMTP_PASSWORD: 16-character Google App Password (NOT your regular password)
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Placement OS <noreply@placementos.com>"

# ====================================================
# Super Admin Security & Private Control Portal
# ====================================================

# ADMIN_ROUTE_SECRET: Private, unpredictable URL secret token.
# Configures the private entry route: /private-control/<ADMIN_ROUTE_SECRET>
# Generates high-entropy random string (recommended: 32+ characters hex or base64).
# Do NOT use personal names, roll numbers, or predictable patterns.
# If unset, the platform uses a high-entropy fallback token in development.
ADMIN_ROUTE_SECRET=""

# ADMIN_EMAIL: Primary Super Administrator login email address.
# Defaults to admin@placementos.com if not specified.
ADMIN_EMAIL="admin@placementos.com"

# ADMIN_INITIAL_PASSWORD: Set initial password for the first admin provisioning.
# Once seeded in the database, this password is NEVER overwritten on server reboot.
# In production, if unset, a cryptographically secure random key is generated.
ADMIN_INITIAL_PASSWORD=""

